# Salin file ini menjadi .env, lalu isi nilai yang sesuai dengan lingkungan.
# Jangan commit .env atau memasukkan secret ke repository.

# -----------------------------------------------------------------------------
# Aplikasi
# -----------------------------------------------------------------------------
APP_NAME=TOMI V2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_PREVIOUS_KEYS=
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=
LOG_SLACK_EMOJI=
LOG_STDERR_FORMATTER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# -----------------------------------------------------------------------------
# Database utama
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_URL=
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
MYSQL_ATTR_SSL_CA=

# Database kedua (dipakai oleh integrasi/fitur yang memerlukannya).
DB_SECOND_HOST=
DB_SECOND_PORT=3306
DB_SECOND_DATABASE=
DB_SECOND_USERNAME=
DB_SECOND_PASSWORD=

# -----------------------------------------------------------------------------
# Session, cache, queue, broadcast, dan Redis
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_EXPIRE_ON_CLOSE=false
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
CACHE_STORE=database
CACHE_PREFIX=
DB_CACHE_TABLE=cache
DB_CACHE_CONNECTION=
DB_CACHE_LOCK_CONNECTION=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_CACHE_DB=1
REDIS_CLUSTER=redis
REDIS_PREFIX=
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=

# -----------------------------------------------------------------------------
# Penyimpanan file / AWS S3
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

# -----------------------------------------------------------------------------
# Autentikasi, OTP, dan enkripsi aplikasi
# -----------------------------------------------------------------------------
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_MODEL=
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
JWT_SECRET=
KEYDECRYPTION=
SALTDECRYPTION=
OTP_ENABLED=true
OTP_LIFETIME=0
OTP_KEEP_ALIVE=true
OTP_THROW_EXCEPTION=true
OTP_TOTP_ISSUER=
WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
WKHTML_IMG_BINARY=/usr/local/bin/wkhtmltoimage

# -----------------------------------------------------------------------------
# FCM dan Google reCAPTCHA
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVER_KEY_PROD=
FCM_PROJECT_ID_PROD=
SECRET_G_CAPTCHA=

# -----------------------------------------------------------------------------
# API internal Koperasi
# -----------------------------------------------------------------------------
KOPERASI_API_URL=http://localhost:8000
KOPERASI_API_IDENTITY=
KOPERASI_API_PASSWORD=

# -----------------------------------------------------------------------------
# Verihubs (OTP)
# -----------------------------------------------------------------------------
VERIHUBS_APP_ID=
VERIHUBS_API_KEY=
VERIHUBS_BASE_URL=https://api.verihubs.com
VERIHUBS_OTP_TEMPLATE=otp_tomi
VERIHUBS_LANG_CODE=id
VERIHUBS_TIME_LIMIT=60

# -----------------------------------------------------------------------------
# BuyLink
# -----------------------------------------------------------------------------
BUYLINK_BASE_URL=https://mitra.buylink.id
BUYLINK_USER_TOKEN=
BUYLINK_LEADER_TOKEN=

# -----------------------------------------------------------------------------
# Privy Digital ID
# -----------------------------------------------------------------------------
# Nama DIGITAL_IDV2_* adalah nama utama. PRIVY_DIGITAL_ID_* dan PRIVY_URL
# dipertahankan sebagai fallback kompatibilitas konfigurasi lama.
DIGITAL_IDV2_PRIVY_ENV=sandbox
DIGITAL_IDV2_PRIVY_ISSUER=https://digitalid.privy.id/
DIGITAL_IDV2_PRIVY_APPLICATION_ID=
DIGITAL_IDV2_PRIVY_BASE_URL=
DIGITAL_IDV2_PRIVY_CLIENT_ID=
DIGITAL_IDV2_PRIVY_CLIENT_SECRET=
DIGITAL_IDV2_PRIVY_PRIVATE_KEY=
DIGITAL_IDV2_PRIVY_PUBLIC_KEY=
DIGITAL_IDV2_PRIVY_MERCHANT_ID=
DIGITAL_IDV2_PRIVY_MERCHANT_API_KEY=
PRIVY_URL=
PRIVY_DIGITAL_ID_ENV=
PRIVY_DIGITAL_ID_ISSUER=
PRIVY_DIGITAL_ID_APPLICATION_ID=
PRIVY_DIGITAL_ID_API_BASE_URL=
PRIVY_DIGITAL_ID_WEB_BASE_URL=
PRIVY_DIGITAL_ID_CLIENT_ID=
PRIVY_DIGITAL_ID_CLIENT_SECRET=
PRIVY_DIGITAL_ID_PRIVATE_KEY=
PRIVY_DIGITAL_ID_PUBLIC_KEY=
PRIVY_DIGITAL_ID_MERCHANT_ID=
PRIVY_DIGITAL_ID_MERCHANT_API_KEY=
PRIVY_SIGN_OWNER_ID=
PRIVY_SIGN_OWNER_ENTERPRISE_TOKEN=

# Tanda tangan digital Privy legacy.
# Saat ini helper lama masih membaca sebagian nilai dari tabel `privies`;
# field ini disediakan sebagai konfigurasi standar untuk migrasi integrasi.
PRIVY_SIGN_USERNAME=
PRIVY_SIGN_PASSWORD=
PRIVY_SIGN_API_KEY=
PRIVY_SIGN_SECRET_KEY=
PRIVY_SIGN_CHANNEL_ID=
PRIVY_SIGN_DOCUMENT_OWNER=
PRIVY_SIGN_ENTERPRISE_TOKEN=
PRIVY_SIGN_BASE_URL=

# -----------------------------------------------------------------------------
# Integrasi opsional
# -----------------------------------------------------------------------------
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Frontend Vite hanya menerima variabel yang diawali VITE_.
VITE_APP_NAME="${APP_NAME}"
