# Template environment TOMI V2.
# Salin menjadi .env, lalu isi nilai sesuai environment.
# Jangan commit file .env atau memasukkan credential ke repository.

# Aplikasi
APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_COLLATION=
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SECOND_HOST=
DB_SECOND_PORT=
DB_SECOND_DATABASE=
DB_SECOND_USERNAME=
DB_SECOND_PASSWORD=

# Session, queue, cache, dan filesystem
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_ADDRESS=

# Storage AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend dan keamanan
VITE_APP_NAME="${APP_NAME}"
JWT_SECRET=
WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
KEYDECRYPTION=
SALTDECRYPTION=

# Notifikasi
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVER_KEY_PROD=
FCM_PROJECT_ID_PROD=

# Privy Digital ID
PRIVY_URL=
DIGITAL_IDV2_PRIVY_APPLICATION_ID=
DIGITAL_IDV2_PRIVY_BASE_URL=
DIGITAL_IDV2_PRIVY_CLIENT_ID=
DIGITAL_IDV2_PRIVY_CLIENT_SECRET=
DIGITAL_IDV2_PRIVY_PRIVATE_KEY=
DIGITAL_IDV2_PRIVY_PUBLIC_KEY=
DIGITAL_IDV2_PRIVY_MERCHANT_API_KEY=
DIGITAL_IDV2_PRIVY_MERCHANT_ID=
PRIVY_SIGN_OWNER_ID=
PRIVY_SIGN_OWNER_ENTERPRISE_TOKEN=

# Captcha dan API internal
SECRET_G_CAPTCHA=
KOPERASI_API_URL=
KOPERASI_API_IDENTITY=
KOPERASI_API_PASSWORD=

# Verihubs
VERIHUBS_APP_ID=
VERIHUBS_API_KEY=
VERIHUBS_BASE_URL=
VERIHUBS_OTP_TEMPLATE=
VERIHUBS_LANG_CODE=
VERIHUBS_TIME_LIMIT=

# BuyLink
BUYLINK_BASE_URL=
BUYLINK_USER_TOKEN=
BUYLINK_LEADER_TOKEN=
